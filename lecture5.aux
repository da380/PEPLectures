\providecommand\zref@newlabel[2]{}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Scattering of a plane p-wave in a homogeneous background model due to its inter- action with a heterogeneity having a typical length-scale approximately equal to the length-scale of the incident wave. The arrows show the particle motion, and we see that the scattered wave field is comprised of both P-waves and S-waves.\relax }}{2}{}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:fig1}{{1}{2}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Passage of a plane p-wave through a heterogeneous region having length-scale much larger than that of the incident wave. Here we see minimal scattering, along with the smooth distortion of the wave front and associated amplitude and polarisation variations. This is a situation to which ray theory can be usefully applied.\relax }}{3}{}\protected@file@percent }
\newlabel{fig:fig2}{{2}{3}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces An example of ray tracing within a heterogeneous body, and of the formation of a caustic due to an area of low velocity.\relax }}{8}{}\protected@file@percent }
\newlabel{fig:fig3}{{3}{8}}
