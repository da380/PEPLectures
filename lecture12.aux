\providecommand\zref@newlabel[2]{}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A plot of eigenfrequencies at different degree for toroidal modes within the earth model PREM of Dziewonski \& Anderson (1981). For each degree, $l$, that is shown we can see a set of different overtones which can be labelled using the overtone number, $n$. Note also that PREM comprises a solid inner core, fluid outer core, and solid mantle and crust. The modes seen here are mantle toroidal modes, but one could also calculate toroidal modes confined to the inner core.\relax }}{3}{}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:fig1}{{1}{3}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces As for Fig 1, but here showing spheroidal mode eigenfrequencies within PREM.\relax }}{5}{}\protected@file@percent }
\newlabel{fig:fig2}{{2}{5}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces A part of the first free oscillation spectrum observed following the 1960 Chile earthquake. Taken from Benioff et al. (1961).\relax }}{8}{}\protected@file@percent }
\newlabel{fig:fig3}{{3}{8}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Variation of density with radius in the model PREM of Dziewonski \& Anderson (1981) as determined from the Earth’s mass, moment of inertia, and over 1000 measured eigenfrequencies.\relax }}{10}{}\protected@file@percent }
\newlabel{fig:fig4}{{4}{10}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Depth slices from a range of different S-wave tomographic models. In all cases the Pacific and African LLSVPs can be seen at the base of the mantle. The dynamical significance of these features remains unclear.\relax }}{11}{}\protected@file@percent }
